{
  "name": "@gnaws/viewer",
  "version": "0.1.0",
  "description": "GNAWS Viewer — Interactive AWS resource graph visualization",
  "license": "AGPL-3.0-only",
  "keywords": ["aws", "graph", "viewer", "visualization", "sigma", "infrastructure"],
  "homepage": "https://github.com/FabioDominio/gnaws-viewer#readme",
  "repository": { "type": "git", "url": "git+https://github.com/FabioDominio/gnaws-viewer.git" },
  "bugs": { "url": "https://github.com/FabioDominio/gnaws-viewer/issues" },
  "files": ["dist", "public"],
  "type": "module",
  "bin": { "gnaws-viewer": "./dist/cli.js" },
  "scripts": {
    "build": "rm -rf dist && swc src/ -d dist --strip-leading-paths",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint --fix .",
    "release": "bumpp",
    "prepare": "[ -d .git ] && husky || true"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@sigma/node-image": "^3.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.2.0",
    "bumpp": "^12.2.1",
    "eslint": "^10.8.1",
    "graphology": "^0.25.4",
    "graphology-types": "^0.24.7",
    "husky": "^9.1.7",
    "sigma": "^3.0.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": { "node": ">=24.0.0" }
}
